#!/usr/bin/env python3
"""Print trade-event messages for 2 minutes. Does not place, modify, or cancel orders.

The sidecar container has the SDK and the credentials. From the repo on corpus:

    docker exec -i gatekeeper-webull python - < scripts/order-events-probe

Place and cancel a far-from-market order during those 2 minutes. A heartbeat
prints as "order event raw type=Ping". An order prints as "order event message".
"""

import sys
from pathlib import Path

here = globals().get("__file__")
if here:
    sys.path.insert(0, str(Path(here).resolve().parents[1] / "sidecar"))
sys.path.insert(0, "/app")

from events import probe_order_events

raise SystemExit(probe_order_events(120))
