#!/usr/bin/env python3
"""Subscribe to one ticker's L1 snapshot stream and log every message and disconnect.

Run this while the Webull app is open:

    python scripts/lock-test BRAI

Uses a new MQTT client id on every connection attempt so it does not replace another session.
"""

import logging
import os
import sys
import threading
import time
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "sidecar"))

from webull.data.common.category import Category
from webull.data.common.subscribe_type import SubscribeType

from webull_data import (
    connect_failure,
    credentials,
    disconnect_reason,
    gatekeeper_stream_check,
    make_streaming_client,
    mqtt_client_id,
    notice_fields,
    reconnect_wait,
    retry_subscribe,
)


def stamp():
    return datetime.now(timezone.utc).isoformat()


def main():
    args = [item for item in sys.argv[1:] if item != "--force"]
    force = "--force" in sys.argv[1:]
    if len(args) != 1:
        print("usage: python scripts/lock-test [--force] SYMBOL", file=sys.stderr)
        return 2
    symbol = args[0].upper()
    key, secret, _http_host, _mqtt_host = credentials()
    if not key or not secret:
        print("WEBULL_APP_KEY and WEBULL_APP_SECRET are required", file=sys.stderr)
        return 2
    blocked = gatekeeper_stream_check(force)
    if blocked:
        return blocked

    logging.basicConfig(level=logging.INFO, format="%(message)s")
    logging.getLogger("webull").setLevel(logging.CRITICAL)
    token_dir = os.environ.get("WEBULL_TOKEN_DIR", str(Path(__file__).resolve().parents[1] / "sidecar" / ".tokens"))
    os.makedirs(token_dir, exist_ok=True)

    def on_message(stream, topic, payload):
        if topic == "notice":
            for kind, content in notice_fields(payload):
                if kind != "1002":
                    continue
                print(f"{stamp()} notice type=1002 content={content}", flush=True)
                yielded.set()
                try:
                    stream.disconnect()
                except Exception:
                    pass
            return
        print(f"{stamp()} message topic={topic} {payload}", flush=True)

    print(f"{stamp()} starting lock-test symbol={symbol}", flush=True)
    attempt = 0
    delay = 1
    yielded = threading.Event()
    try:
        while True:
            attempt += 1
            session_id = mqtt_client_id("lock-test", attempt)
            closed = threading.Event()
            held = {"ok": False}
            client = make_streaming_client(session_id, token_dir)

            def on_connect(stream, api_client, connected_session, _held=held, _closed=closed):
                print(
                    f"{stamp()} connect rc=0 reason=Connection successful client_id={connected_session}",
                    flush=True,
                )
                _held["ok"] = True

                def subscribe():
                    stream.subscribe(
                        [symbol],
                        Category.US_STOCK.name,
                        [SubscribeType.SNAPSHOT.name],
                    )

                def on_error(http, code, msg):
                    print(
                        f"{stamp()} subscribe http={http} code={code} msg={msg} client_id={connected_session}",
                        flush=True,
                    )

                threading.Thread(
                    target=retry_subscribe,
                    args=(stream, subscribe, lambda: not _closed.is_set(), on_error),
                    name="subscribe",
                    daemon=True,
                ).start()

            def on_disconnect(stream, userdata, *args, _sid=session_id):
                rc = args[0] if args else None
                print(
                    f"{stamp()} disconnect rc={rc} reason={disconnect_reason(rc)} client_id={_sid}",
                    flush=True,
                )

            client.on_connect_success = on_connect
            client.on_quotes_message = on_message
            client.on_disconnect = on_disconnect
            try:
                client.connect_and_loop_forever(timeout=1, logger_enable=False)
            except KeyboardInterrupt:
                raise
            except Exception as exc:
                rc, reason = connect_failure(exc)
                print(f"{stamp()} connect rc={rc} reason={reason} client_id={session_id}", flush=True)
            finally:
                closed.set()
                try:
                    client.disconnect()
                except Exception:
                    pass
            sleep_for, delay = reconnect_wait(held["ok"], delay)
            if yielded.is_set():
                break
            time.sleep(sleep_for)
    except KeyboardInterrupt:
        print(f"{stamp()} disconnect local-interrupt", flush=True)
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
