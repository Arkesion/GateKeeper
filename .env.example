# Schwab OAuth (required)
SCHWAB_CLIENT_ID=your_app_key
SCHWAB_CLIENT_SECRET=your_app_secret
PUBLIC_URL=https://your-host.example
REDIRECT_URI=https://your-host.example/callback

# Server
PORT=3000
TOKEN_PATH=/data/tokens.json

# Market data provider: schwab (default) or webull
MARKET_DATA_PROVIDER=schwab
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_HTTP_HOST=api.webull.com
WEBULL_MQTT_HOST=data-api.webull.com
REDIS_URL=redis://redis:6379
# Scripts read this before opening their own MQTT session.
# In production this is the corpus URL over Tailscale, not localhost.
GATEKEEPER_URL=

# Poll intervals (milliseconds)
QUOTE_POLL_MS=1000
CANDLE_POLL_MS=2000
STATE_POLL_MS=1000
DAILY_CACHE_MS=60000
INDICATOR_1M_CACHE_MS=60000
NASDAQ_HALT_POLL_MS=60000
